<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.litellm-proxy</string>

    <key>ProgramArguments</key>
    <array>
        <string>/path/to/your/run.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <!-- Network binding -->
        <key>LITELLM_BIND</key>
        <string>127.0.0.1:4000</string>
        <!-- Secret file paths (recommended). Use *_API_KEY_PATH so the proxy
             reads the file at runtime. -->
        <!-- <key>CHUTES_API_KEY_PATH</key> -->
        <!-- <string>/path/to/secret/file</string> -->
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/Library/Logs/litellm.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/Library/Logs/litellm-error.log</string>
</dict>
</plist>
